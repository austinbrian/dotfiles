" set airline theme — 'dark' follows terminal colors
let g:airline_theme='dark'


" Spell check, deliberately quiet.
"
" It used to be an angry red undercurl that fought the rest of the palette. The
" signal-to-noise does not justify that: prose spelling is a nice-to-have, and
" the false positives here are relentless (ticket refs, identifiers, jargon).
" So: one muted grey-blue undercurl for every category, no foreground override
" at all — the word keeps its normal colour and only picks up a faint squiggle.
"
" ctermfg is explicitly NONE. Setting it was what actually recoloured the *text*
" in the 256-colour fallback, which is most of what read as "angry".
"
" The false positives are attacked separately, and that is the more useful half:
"   after/syntax/markdown.vim  — @NoSpell for ticket refs, code, URLs, acronyms
"   spell/en.utf-8.add         — the domain and tooling vocabulary
" 'spelloptions=camel' stops camelCase identifiers being split into nonsense
" (evaluationDate is one word, not "evaluation" + "Date").
set spelloptions=camel
set spellfile=~/.vim/spell/en.utf-8.add

function! s:SubtleSpell() abort
  highlight SpellBad   cterm=underline ctermfg=NONE ctermbg=NONE gui=undercurl guifg=NONE guibg=NONE guisp=#4C566A
  highlight SpellCap   cterm=NONE      ctermfg=NONE ctermbg=NONE gui=NONE      guifg=NONE guibg=NONE guisp=NONE
  highlight SpellRare  cterm=underline ctermfg=NONE ctermbg=NONE gui=undercurl guifg=NONE guibg=NONE guisp=#434C5E
  highlight SpellLocal cterm=NONE      ctermfg=NONE ctermbg=NONE gui=NONE      guifg=NONE guibg=NONE guisp=NONE
endfunction

augroup SubtleSpell
  autocmd!
  autocmd ColorScheme,VimEnter,Syntax * call s:SubtleSpell()
augroup END
" Also apply now: VimEnter has already fired for a session that sources this
" late, and the default SpellBad (#ff0000) would otherwise survive until the
" next colorscheme change.
call s:SubtleSpell()

" Markdown to match the shared "Nord Salmon" theme, so a daylog looks the same
" in vim as it does through `daylog` (bat/less) and `dlog` (glow).
"   headings          #81A1C1  nord9   blue
"   code / backticks  #BF616A  nord11  salmon
"   emphasis          #EBCB8B  nord13  yellow, bold + italic so it pops
"   strong            #ECEFF4  nord6   brightest fg, bold
"   links             #88C0D0  nord8   frost cyan
"
" These target the groups plasticboy/vim-markdown actually creates, NOT the
" built-in markdown syntax's markdownH1/markdownCode — those groups never exist
" here, which is why setting them did nothing. Under vim-markdown:
"   headings     htmlH1..htmlH6  (default: -> Title  -> magenta, the purple)
"   inline code  mkdCode         (default: -> String -> Constant)
"   heading #s   mkdHeading
" Verify with :echo synIDattr(synID(line('.'),col('.'),1),'name') on the text.
"
" Vim runs no colorscheme — iTerm2 owns the palette — so these are set directly
" rather than layered over one. Hooked on Syntax as well as ColorScheme/VimEnter:
" vim-markdown uses `hi def link`, which will not clobber an existing definition,
" but a buffer opened after startup loads its syntax fresh.
function! s:NordSalmonMarkdown() abort
  highlight htmlH1 cterm=bold ctermfg=110 gui=bold guifg=#81A1C1
  highlight htmlH2 cterm=bold ctermfg=110 gui=bold guifg=#81A1C1
  highlight htmlH3 cterm=bold ctermfg=110 gui=bold guifg=#81A1C1
  highlight htmlH4 ctermfg=110 guifg=#81A1C1
  highlight htmlH5 ctermfg=110 guifg=#81A1C1
  highlight htmlH6 ctermfg=110 guifg=#81A1C1
  highlight mkdHeading ctermfg=110 guifg=#81A1C1
  highlight Title cterm=bold ctermfg=110 gui=bold guifg=#81A1C1

  highlight mkdCode          ctermfg=131 guifg=#BF616A
  highlight mkdCodeStart     ctermfg=131 guifg=#BF616A
  highlight mkdCodeEnd       ctermfg=131 guifg=#BF616A
  highlight mkdCodeDelimiter ctermfg=131 guifg=#BF616A
  highlight mkdString        ctermfg=131 guifg=#BF616A

  " vim-markdown routes emphasis through the *html* groups, not mkdItalic/mkdBold.
  " emph  = nord13 yellow  #EBCB8B  bold + italic
  " strong= nord12 orange  #D08770  bold      (trial; revert to #ECEFF4 to mute)
  highlight htmlItalic cterm=bold,italic ctermfg=222 gui=bold,italic guifg=#EBCB8B
  highlight htmlBold   cterm=bold ctermfg=173 gui=bold guifg=#D08770
  highlight htmlBoldItalic cterm=bold,italic ctermfg=173 gui=bold,italic guifg=#D08770
  highlight mkdItalic  cterm=bold,italic ctermfg=222 gui=bold,italic guifg=#EBCB8B
  highlight mkdBold    cterm=bold ctermfg=173 gui=bold guifg=#D08770

  highlight mkdLink       cterm=bold ctermfg=110 gui=bold guifg=#81A1C1
  highlight mkdURL        ctermfg=109 gui=underline guifg=#88C0D0
  highlight mkdInlineURL  ctermfg=109 gui=underline guifg=#88C0D0
  highlight mkdListItem   ctermfg=110 guifg=#81A1C1
  highlight mkdRule       ctermfg=103 guifg=#4C566A
  highlight mkdBlockquote ctermfg=103 guifg=#4C566A

  " Built-in markdown syntax, for when vim-markdown is not loaded
  highlight link markdownH1 htmlH1
  highlight link markdownH2 htmlH2
  highlight link markdownH3 htmlH3
  highlight link markdownH4 htmlH4
  highlight link markdownH5 htmlH5
  highlight link markdownH6 htmlH6
  highlight link markdownCode          mkdCode
  highlight link markdownCodeBlock     mkdCode
  highlight link markdownCodeDelimiter mkdCode
  highlight link markdownItalic        mkdItalic
  highlight link markdownBold          mkdBold
  highlight link markdownUrl           mkdURL
  highlight link markdownLinkText      mkdLink
  highlight link markdownListMarker    mkdListItem
  highlight link markdownBlockquote    mkdBlockquote
  highlight link markdownRule          mkdRule
endfunction

augroup NordSalmonMarkdown
  autocmd!
  autocmd ColorScheme,VimEnter * call s:NordSalmonMarkdown()
  autocmd Syntax markdown call s:NordSalmonMarkdown()
augroup END
call s:NordSalmonMarkdown()

" I like it when vim wraps the lines in .md files
set linebreak

" Remove snipmate deprecation warning
let g:snipMate= { 'snippet_version' : 1 }

" Refresh NERDTree when it's opened
map <C-n> :call NERDTreeToggleAndRefresh()<CR>

function NERDTreeToggleAndRefresh()
    :NERDTreeToggle
      if g:NERDTree.IsOpen()
            :NERDTreeRefreshRoot
              endif
endfunction

" Use tab for trigger completion with characters ahead and navigate.
" NOTE: There's always complete item selected by default, you may want to enable
" no select by `"suggest.noselect": true` in your configuration file.
" NOTE: Use command ':verbose imap <tab>' to make sure tab is not mapped by
" other plugin before putting this into your config.
inoremap <silent><expr> <TAB>
      \ coc#pum#visible() ? coc#pum#next(1) :
      \ CheckBackspace() ? "\<Tab>" :
      \ coc#refresh()
inoremap <expr><S-TAB> coc#pum#visible() ? coc#pum#prev(1) : "\<C-h>"

" Make <CR> to accept selected completion item or notify coc.nvim to format
" <C-g>u breaks current undo, please make your own choice.
inoremap <silent><expr> <CR> coc#pum#visible() ? coc#pum#confirm()
                              \: "\<C-g>u\<CR>\<c-r>=coc#on_enter()\<CR>"

" shortcut for wrapping strings
" set tw=88
noremap <g-w> gqap<CR>

" shortcut to format json nicely
noremap <g-j> :%!jq<CR>


" Use terminal colors — iTerm2 owns the palette
set background=dark
set termguicolors

" Dim inactive windows using 'colorcolumn' setting
" This tends to slow down redrawing, but is very useful.
" Based on https://groups.google.com/d/msg/vim_use/IJU-Vk-QLJE/xz4hjPjCRBUJ
" XXX: this will only work with lines containing text (i.e. not '~')
" from 
" if exists('+colorcolumn')
"   function! s:DimInactiveWindows()
"     for i in range(1, tabpagewinnr(tabpagenr(), '$'))
"       let l:range = ""
"       if i != winnr()
"         if &wrap
"          " HACK: when wrapping lines is enabled, we use the maximum number
"          " of columns getting highlighted. This might get calculated by
"          " looking for the longest visible line and using a multiple of
"          " winwidth().
"          let l:width=256 " max
"         else
"          let l:width=winwidth(i)
"         endif
"         let l:range = join(range(1, l:width), ',')
"       endif
"       call setwinvar(i, '&colorcolumn', l:range)
"     endfor
"   endfunction
"   augroup DimInactiveWindows
"     au!
"     au WinEnter * call s:DimInactiveWindows()
"     au WinEnter * set cursorline
"     au WinLeave * set nocursorline
"   augroup END
" endif

" Github Copilot settings
let g:copilot_filetypes = {
      \ 'gitcommit':v:true,
      \ 'markdown':v:true,
      \ 'python':v:true,
      \ 'javascript':v:true,
      \ 'typescript':v:true,
      \ 'yaml':v:true,
      \ 'json':v:true,
      \ }   
""
" disable copilot for large files
 autocmd BufReadPre *
     \ let f=getfsize(expand("<afile>"))
     \ | if f > 100000 || f == -2
     \ | let b:copilot_enabled = v:false
     \ | endif
